# ==============================================================================
# PromptCut Configuration Template (.env.example)
# Copy to .env and adjust variables as required.
# All settings are read from environment variables — no hard-coded keys in code.
# ==============================================================================

# ── 1. LLM & Natural Language Interpreter ────────────────────────────────────
# GROQ_API_KEY: Optional. If unset, engine defaults to 100% deterministic Rule/Mock adapter.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# INTERPRETER mode: "auto" (Groq if key present, else rule), "rule_only", or "llm_only"
INTERPRETER=auto

# ── 2. Transcription Adapter ─────────────────────────────────────────────────
# "auto"    -> tries groq -> faster-whisper -> vosk -> mock (in that order)
# "groq"    -> Groq Whisper cloud (requires GROQ_API_KEY)
# "whisper" -> local Faster-Whisper
# "vosk"    -> local Vosk offline ASR
# "mock"    -> synthetic fixture (no API keys needed; safe for CI)
TRANSCRIPTION_ADAPTER=auto

# ── 3. Storage Backend (IncuBrix Integration Standard #7) ────────────────────
# "local"        -> local filesystem under SESSIONS_DIR (default, no extra services)
# "s3" / "minio" -> S3-compatible object store; rendered files returned as presigned URLs
STORAGE_BACKEND=local
SESSIONS_DIR=.promptcut_sessions

# S3 / MinIO Configuration (used when STORAGE_BACKEND=s3 or minio)
# MinIO is included in docker-compose.yml. Start with:  docker compose up
# To use S3 storage mode:  STORAGE_BACKEND=s3 docker compose up
S3_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=promptcut-media

# ── 4. Webhooks & Security (IncuBrix Integration Standard #3 & #8) ──────────
# Secret key for signing outgoing HMAC-SHA256 webhooks (X-IncuBrix-Signature header)
INCUBRIX_WEBHOOK_SECRET=incubrix_shared_webhook_secret_key_12345

# ── 5. Timeline Engine ───────────────────────────────────────────────────────
# TIME_POLICY: "original" (timestamps refer to original video) or "current"
TIME_POLICY=original
# Silence snap tolerance in seconds (cuts snap to nearest silence within this radius)
SILENCE_SNAP_TOLERANCE_S=0.25
