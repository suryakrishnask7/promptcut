    "RemoveFillers": {
      "description": "Cut all words whose normalised text matches any entry in ``filler_words``.\n\nNormalisation: lowercase, strip leading/trailing punctuation.\nCommon defaults: [\"um\", \"uh\", \"like\"].",
      "properties": {
        "op_id": {
          "default": -1,
          "title": "Op Id",
          "type": "integer"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "interpreted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpreted By"
        },
        "op_type": {
          "const": "remove_fillers",
          "default": "remove_fillers",
          "title": "Op Type",
          "type": "string"
        },
        "filler_words": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Filler Words",
          "type": "array"
        }
      },
      "required": [
        "filler_words"
      ],
      "title": "RemoveFillers",
      "type": "object"
    },
    "RemoveSilences": {
      "description": "Compress inter-word gaps that exceed ``min_silence_secs`` down to\n``max_gap_secs`` in the output timeline.\n\nWords are NOT cut; only the gaps between them are shortened.\nApplied at segment-build time in the engine (see engine.py).",
      "properties": {
        "op_id": {
          "default": -1,
          "title": "Op Id",
          "type": "integer"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "interpreted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpreted By"
        },
        "op_type": {
          "const": "remove_silences",
          "default": "remove_silences",
          "title": "Op Type",
          "type": "string"
        },
        "min_silence_secs": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Min Silence Secs",
          "type": "number"
        },
        "max_gap_secs": {
          "default": 0.3,
          "minimum": 0.0,
          "title": "Max Gap Secs",
          "type": "number"
        }
      },
      "title": "RemoveSilences",
      "type": "object"
    },
    "ReorderSections": {
      "description": "Lay out the timeline as an ordered list of word-ID sections.\n\nEach inner list is a contiguous block of word IDs that will appear in the\noutput in the order listed.  Words absent from every section are excluded\nfrom the output (see RULES.md \u00a7Reorder).",
      "properties": {
        "op_id": {
          "default": -1,
          "title": "Op Id",
          "type": "integer"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "interpreted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpreted By"
        },
        "op_type": {
          "const": "reorder_sections",
          "default": "reorder_sections",
          "title": "Op Type",
          "type": "string"
        },
        "sections": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "title": "ReorderSections",
      "type": "object"
    },
    "SetCaptionStyle": {
      "description": "Update visual style attributes (color, font_size, position, font_style, text) of a caption.\n\nIf target_caption_op_id is None and exactly one caption exists, applies to it.",
      "properties": {
        "op_id": {
          "default": -1,
          "title": "Op Id",
          "type": "integer"
        },
        "active": {
          "default": true,
