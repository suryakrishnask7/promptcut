    "ZoomSpeaker": {
      "description": "Apply a visual zoom / punch-in effect to the video during the listed words.\n\nfactor: zoom magnification factor (>1.0 = punch in / closer framing, e.g. 1.2 = 20% zoom).\nanchor: visual framing anchor point (\"center\", \"top\").",
      "properties": {
        "op_id": {
          "default": -1,
          "title": "Op Id",
          "type": "integer"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "interpreted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpreted By"
        },
        "op_type": {
          "const": "zoom_speaker",
          "default": "zoom_speaker",
          "title": "Op Type",
          "type": "string"
        },
        "word_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Word Ids",
          "type": "array"
        },
        "factor": {
          "default": 1.2,
          "exclusiveMinimum": 0.5,
          "maximum": 3.0,
          "title": "Factor",
          "type": "number"
        },
        "anchor": {
          "default": "center",
          "enum": [
            "center",
            "top"
          ],
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "word_ids"
      ],
      "title": "ZoomSpeaker",
      "type": "object"
    }
  },
  "description": "Append-only operation history with undo/redo pointer.\n\nops     \u2013 all operations ever pushed (including ones beyond ``pointer``\n          that could be redo'd, until a new push clears them).\npointer \u2013 how many ops are currently \"in scope\" (0 = fully undone).",
  "properties": {
    "ops": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_caption": "#/$defs/AddCaption",
            "add_music_ducked": "#/$defs/AddMusicDucked",
            "auto_caption": "#/$defs/AutoCaption",
            "bleep_words": "#/$defs/BleepWords",
            "cut_range": "#/$defs/CutRange",
            "keep_range": "#/$defs/KeepRange",
            "mask_captions": "#/$defs/MaskCaptions",
            "mute_words": "#/$defs/MuteWords",
            "remove_fillers": "#/$defs/RemoveFillers",
            "remove_silences": "#/$defs/RemoveSilences",
            "reorder_sections": "#/$defs/ReorderSections",
            "set_caption_style": "#/$defs/SetCaptionStyle",
            "speed_range": "#/$defs/SpeedRange",
            "unbleep_words": "#/$defs/UnbleepWords",
            "unmask_captions": "#/$defs/UnmaskCaptions",
            "zoom_speaker": "#/$defs/ZoomSpeaker"
          },
          "propertyName": "op_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CutRange"
          },
          {
            "$ref": "#/$defs/KeepRange"
          },
          {
            "$ref": "#/$defs/ReorderSections"
          },
          {
            "$ref": "#/$defs/SpeedRange"
          },
          {
            "$ref": "#/$defs/ZoomSpeaker"
          },
          {
            "$ref": "#/$defs/MuteWords"
          },
          {
            "$ref": "#/$defs/BleepWords"
          },
          {
            "$ref": "#/$defs/UnbleepWords"
          },
          {
            "$ref": "#/$defs/AddCaption"
          },
          {
            "$ref": "#/$defs/SetCaptionStyle"
          },
          {
            "$ref": "#/$defs/AutoCaption"
          },
          {
            "$ref": "#/$defs/MaskCaptions"
          },
          {
            "$ref": "#/$defs/UnmaskCaptions"
          },
          {
            "$ref": "#/$defs/RemoveFillers"
          },
          {
            "$ref": "#/$defs/RemoveSilences"
          },
          {
            "$ref": "#/$defs/AddMusicDucked"
          }
        ]
      },
      "title": "Ops",
      "type": "array"
    },
    "pointer": {
      "default": 0,
      "minimum": 0,
      "title": "Pointer",
      "type": "integer"
    },
    "action_history": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
